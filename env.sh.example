#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# benchmark-tts — redirection de TOUT l'état lourd vers D:
#
#   cp env.sh.example env.sh      # env.sh est ignoré par git
#   source env.sh                 # AVANT tout script (doctor, fetch, génération)
#
# Objectif : aucune écriture implicite sur C: (45 Go libres seulement).
# Tout — venvs, caches pip/uv, poids Hugging Face, audio généré — va sur D:.
# ---------------------------------------------------------------------------

# Racine unique de l'état lourd. 402 Go libres sur D: au moment du cadrage.
export TTSB_ROOT="/mnt/d/tts-benchmark-data"

# --- Hugging Face (poids, datasets, hub) ---
export HF_HOME="$TTSB_ROOT/hf"
export HF_HUB_CACHE="$TTSB_ROOT/hf/hub"
export HF_HUB_ENABLE_HF_TRANSFER="1"   # téléchargements rapides (paquet hf_transfer)
export HF_HUB_DISABLE_TELEMETRY="1"

# --- PyTorch (torch.hub, poids annexes) ---
export TORCH_HOME="$TTSB_ROOT/torch"

# --- Gestionnaires de paquets ---
export UV_CACHE_DIR="$TTSB_ROOT/uv-cache"
export UV_PYTHON_INSTALL_DIR="$TTSB_ROOT/uv-python"
export PIP_CACHE_DIR="$TTSB_ROOT/pip-cache"

# --- Caches applicatifs qui, sinon, retombent dans ~/.cache (donc C:) ---
export XDG_CACHE_HOME="$TTSB_ROOT/xdg-cache"
export NUMBA_CACHE_DIR="$TTSB_ROOT/xdg-cache/numba"
export MPLCONFIGDIR="$TTSB_ROOT/xdg-cache/matplotlib"

# --- Emplacements propres au benchmark ---
export TTSB_VENVS="$TTSB_ROOT/venvs"           # un venv par modèle, créé par uv
export TTSB_AUDIO_OUT="$TTSB_ROOT/audio_genere" # audio généré (volumineux)

mkdir -p \
  "$HF_HUB_CACHE" "$TORCH_HOME" "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" \
  "$PIP_CACHE_DIR" "$XDG_CACHE_HOME" "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR" \
  "$TTSB_VENVS" "$TTSB_AUDIO_OUT"

echo "[env] TTSB_ROOT=$TTSB_ROOT  (source OK)"
